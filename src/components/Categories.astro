---
import Category from "./Category.astro";
import { selectCategories } from "../lib/categories";

const allCategories = selectCategories(
  Object.values(
    import.meta.glob("../../content/categories/*.md", { eager: true }),
  ) as any[],
);
---

<main id="catalog">
    {allCategories.map((category, index) => <Category category={category} index={index} />)}
</main>
